{
  "name": "dsh-context-governor",
  "version": "0.2.2",
  "description": "Session context governor for DeepSeek Harness: prompt size and per-step cost in dollars (cache-read/cache-write aware), cache-hit, context bands, a per-session compaction threshold derived from the model window, DeepSeek balance and peak/off-peak tariff, and a one-click handoff. It never calls a model and spends no tokens.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "test"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "tokens",
    "cost",
    "cache-hit",
    "compaction",
    "deepseek-balance",
    "off-peak"
  ],
  "author": "Michael A. Pinaev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpinaev/dsh-context-governor.git"
  },
  "homepage": "https://github.com/mpinaev/dsh-context-governor#readme",
  "bugs": {
    "url": "https://github.com/mpinaev/dsh-context-governor/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
